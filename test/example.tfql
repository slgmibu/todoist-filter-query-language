// ==============================================================
// Todoist Filter Query Language (TFQL) Full Specification Test
// Reference: https://www.todoist.com/help/todoist/features/introduction-to-filters-V98wIH
// ==============================================================

// --- 1. Official Handy Filter Examples ---
added by: me
assigned to: me
assigned by: me
added by: Becky
assigned to: Becky
view all
uncompletable
subtask
!subtask
shared & !assigned
no date & no deadline
#Later & no date
no time
no date | no time
created before: -365 days
(today | overdue) & #Work
(p1 | p2) & 14 days
created before: -30 days
saturday & %night
#Work & assigned to: me

// --- 2. Label Variations (@ and % prefixes & wildcards) ---
today & %email
%work | %office
7 days & %waiting
(assigned to: Denise | assigned to: Carol) & (due after: sunday & due before: 8 days after sunday) & %Todoist
(all | today) & (all | overdue) & %work
today & !#Work
#Homework & tomorrow & !%languages
%home*
no labels
@urgent & (@work | @deepwork) & !@blocked

// --- 3. Projects, Folders, Sections & Escaped Characters ---
#*Work
/*Work*
!/*
!/* & !#Inbox
##Design team
#One \ & Two
#Shopping\ list
##School & !#Science
#Work & /Meetings

// --- 4. Workspaces & Organizational Filters ---
workspace: My projects
workspace: Doist
(workspace: Doist | workspace: Halist)

// --- 5. Dates, Times, Deadlines & Offsets ---
date: jan 3
date before: may 5 or date before: 5/5
date after: may 5 or date after: 5/5
due before: +4 hours
due before: next week
due before: sat
(due: next week | due after: next week) & due before: 1 week after next week
due before: first day
due: yesterday,
today
today & due before: today at 2pm
overdue or over due or od
overdue & !no time,
today & !no time
5 days or next 5 days
recurring
!recurring
no time & !recurring
deadline: today
deadline after: yesterday & deadline before: in 7 days
deadline before: today
no deadline
!no deadline

// --- 6. Search Queries (Quoted & Unquoted) ---
search: Meeting
search: Meeting & today
search: send email
search: "quarterly review" & ##Operations
search: "migration" & @infra & due: next week

// --- 7. Compound Multi-section Filters (comma delimited) ---
#Inbox & no date,
all & !#Inbox & !no date
today & overdue,
p1 & no date,
##Work & /Urgent,
assigned to: me & !completed

// --- 8. Best Practices for Filters (Wildcards, Multiple Lists & Emojis) ---
p1 & overdue,
p4 & today
%urgent*
#Welcome 👋
#Welcome *
/Sprint 🚀
%Café
#Projet Été
