// ==============================================================
// Todoist Filter Query Language (TFQL) Test Suite
// Extensions: .tfql, .tdq, .todoist
// ==============================================================

// --- Section 1: Daily Focus & Priority Matrix ---
(today | overdue) & (p1 | p2)
today & !#Work & @personal
no date & p1 & !subtask

// --- Section 2: Projects, Subprojects, & Sections ---
##Work & /Current Sprint & assigned to: me
#"Client Alpha" & !/Archive & p1
#Personal & (due before: next sunday | overdue)
##Engineering & /* & @bug

// --- Section 3: Temporal & Relative Queries ---
due before: +7d & !due: today & !assigned
created after: -14d & @backend & p1
deadline before: next friday & (due: tomorrow | overdue)
due on: 2026-10-01 & !completed

// --- Section 4: Assignments, Collaboration & Labels ---
shared & assigned to: me & !@waiting
assigned by: me & !assigned to: me
@urgent & (@work | @deepwork) & !@blocked
no label & #Inbox & p2

// --- Section 5: Search & Text Matching ---
search: "quarterly review" & ##Operations
search: "database migration" & @infra & due: next week

// --- Section 6: Compound Multi-section Filters (comma delimited) ---
today & overdue,
p1 & no date,
##Work & /Urgent,
assigned to: me & !completed
